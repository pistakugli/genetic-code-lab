    "benchmark:nn-deep-blackbox-relu-nd-region-sampler": "ts-node scripts/benchmark-nn-deep-blackbox-relu-nd-region-sampler.ts",
    "benchmark:nn-noisy-adaptive-adversarial-deep-blackbox-relu-nd-region-sampler": "ts-node scripts/benchmark-nn-noisy-adaptive-adversarial-deep-blackbox-relu-nd-region-sampler.ts",
