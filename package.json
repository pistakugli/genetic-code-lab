    "benchmark:nn-noisy-blackbox-relu2d-near-parallel": "GCL_NOISY_BLACKBOX_RELU2D_PROFILE=near-parallel GCL_BENCHMARK_VARIANT=near-parallel ts-node scripts/benchmark-nn-noisy-blackbox-relu2d-decompile.ts",
    "benchmark:nn-noisy-blackbox-relu2d-near-collision": "GCL_NOISY_BLACKBOX_RELU2D_PROFILE=near-collision GCL_BENCHMARK_VARIANT=near-collision ts-node scripts/benchmark-nn-noisy-blackbox-relu2d-decompile.ts",
    "benchmark:airfoil-real": "python3 scratch/prepare_airfoil_realdata.py && ts-node scratch/run_airfoil_gcl.ts",
