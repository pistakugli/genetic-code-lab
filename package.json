    "benchmark:nn-gelu-ffn-noisy-mixed-structure": "ts-node scripts/benchmark-nn-gelu-ffn-noisy-mixed-structure.ts",
    "benchmark:nn-gelu-ffn-provenance-verifier": "ts-node scripts/benchmark-nn-gelu-ffn-provenance-verifier.ts",
    "benchmark:nn-swiglu-ffn-mixed-structure": "ts-node scripts/benchmark-nn-swiglu-ffn-mixed-structure.ts",
