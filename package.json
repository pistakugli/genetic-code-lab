    "benchmark:nn-blackbox-relu-nd-line-probe": "ts-node scripts/benchmark-nn-blackbox-relu-nd-line-probe.ts",
    "benchmark:nn-blackbox-relu-nd-line-probe-randomized": "ts-node scripts/benchmark-nn-blackbox-relu-nd-line-probe-randomized.ts",
    "benchmark:nn-noisy-blackbox-relu-nd-line-probe": "ts-node scripts/benchmark-nn-noisy-blackbox-relu-nd-line-probe.ts",
    "benchmark:nn-noisy-blackbox-relu-nd-adversarial": "ts-node scripts/benchmark-nn-noisy-blackbox-relu-nd-adversarial.ts",
    "benchmark:nn-noisy-blackbox-relu-nd-adaptive-adversary": "ts-node scripts/benchmark-nn-noisy-blackbox-relu-nd-adaptive-adversary.ts",
    "benchmark:nn-nd-adjacency-geometry-6d-adaptive-probe": "ts-node scripts/benchmark-nn-nd-adjacency-geometry-6d-adaptive-probe.ts",
    "benchmark:nn-nd-adjacency-geometry-6d-baselines": "ts-node scripts/benchmark-nn-nd-adjacency-geometry-6d-baselines.ts",
    "benchmark:nn-nd-adjacency-geometry-6d-query-budget": "ts-node scripts/benchmark-nn-nd-adjacency-geometry-6d-query-budget.ts",
    "benchmark:nn-nd-adjacency-geometry-6d-robustness": "ts-node scripts/benchmark-nn-nd-adjacency-geometry-6d-robustness.ts",
