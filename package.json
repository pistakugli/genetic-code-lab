    "benchmark:nn-gpt2-gelu-ffn-real-structure": "ts-node scripts/benchmark-nn-gpt2-gelu-ffn-real-structure.ts",
    "benchmark:nn-gpt2-gelu-ffn-real-structure:top5": "GCL_GPT2_COMPACT_FIXTURE=benchmarks/fixtures/gpt2-layer0-output0-top5-gelu.json GCL_BENCHMARK_VARIANT=layer0-output0-top5-blind-source-mapping ts-node scripts/benchmark-nn-gpt2-gelu-ffn-real-structure.ts",
    "benchmark:nn-gpt2-gelu-ffn-real-structure:top8": "GCL_GPT2_COMPACT_FIXTURE=benchmarks/fixtures/gpt2-layer0-output0-top8-gelu.json GCL_BENCHMARK_VARIANT=layer0-output0-top8-blind-source-mapping ts-node scripts/benchmark-nn-gpt2-gelu-ffn-real-structure.ts",
    "benchmark:nn-gpt2-gelu-ffn-real-structure:top10": "GCL_GPT2_COMPACT_FIXTURE=benchmarks/fixtures/gpt2-layer0-output0-top10-gelu.json GCL_BENCHMARK_VARIANT=layer0-output0-top10-blind-source-mapping ts-node scripts/benchmark-nn-gpt2-gelu-ffn-real-structure.ts",
    "benchmark:nn-gpt2-gelu-ffn-source-extractor": "ts-node scripts/benchmark-nn-gpt2-gelu-ffn-source-extractor.ts",
    "research:nn-gpt2-gelu-ffn-structure-finder": "ts-node scripts/research-gpt2-gelu-ffn-structure-finder.ts",
    "research:nn-gpt2-gelu-ffn-full-rank-cap-negative": "ts-node scripts/research-gpt2-gelu-ffn-full-rank-cap-negative.ts",
    "experiment:nn-nd-adjacency-geometry-5d": "ts-node scripts/experiment-nn-nd-adjacency-geometry-5d.ts",
    "experiment:nn-nd-adjacency-geometry-6d": "ts-node scripts/experiment-nn-nd-adjacency-geometry-6d.ts"
  },
