    "benchmark:nn-nd-adjacency-geometry-5d-sweep": "ts-node scripts/benchmark-nn-nd-adjacency-geometry-5d-sweep.ts",
    "benchmark:nn-nd-adjacency-geometry-6d-sweep": "ts-node scripts/benchmark-nn-nd-adjacency-geometry-6d-sweep.ts",
    "benchmark:nn-blackbox-relu2d-decompile": "ts-node scripts/benchmark-nn-blackbox-relu2d-decompile.ts",
    "benchmark:nn-blackbox-relu3d-decompile": "ts-node scripts/benchmark-nn-blackbox-relu3d-decompile.ts",
    "benchmark:nn-blackbox-relu3d-randomized": "ts-node scripts/benchmark-nn-blackbox-relu3d-randomized.ts",
    "benchmark:nn-noisy-blackbox-relu-decompile": "ts-node scripts/benchmark-nn-noisy-blackbox-relu-decompile.ts",
    "benchmark:nn-noisy-blackbox-relu2d-decompile": "ts-node scripts/benchmark-nn-noisy-blackbox-relu2d-decompile.ts",
    "benchmark:nn-noisy-blackbox-relu3d-decompile": "ts-node scripts/benchmark-nn-noisy-blackbox-relu3d-decompile.ts",
    "benchmark:nn-noisy-blackbox-relu3d-randomized": "ts-node scripts/benchmark-nn-noisy-blackbox-relu3d-randomized.ts",
