# Dependencies and build output
node_modules/
dist/
coverage/
.nyc_output/
*.tsbuildinfo

# Local runtime and generated logs
*.log
output*.log
reauth_*.log
result_island_*.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scratch, legacy audits, proof packs, and generated reports
scratch/
artifacts/
audit/
REPORTS/
.gemini/
antigravity/
.antigravity/
audit_*.json
audit-frontier-*.json
proof_pack/
proof_pack*.tar.gz
*.tgz

# Benchmark outputs generated outside release evidence
benchmarks/scratch/
benchmarks/*.csv
benchmarks/*.txt
benchmarks/*.json
benchmarks/*.md

# Keep release evidence under version control
!benchmarks/release/
!benchmarks/release/**

# Generated JavaScript from TypeScript test runs
tests/*.js
tests/*.js.map
tests/*.d.ts
tests/*.d.ts.map

# Local persistence and machine state
persistence/
.cache/
.DS_Store
*.swp

# Secrets and local environment
.env
.env.*
!.env.example
